+const REPLACEMENT_TIMEOUT: Duration = Duration::from_secs(60);
+const REPLACEMENT_READBACK_SETTLE: Duration = Duration::from_millis(500);
+
+fn replacement_scalar_supported(scalar: char) -> bool {
+    // Chromium's native keyboard path truncates non-BMP characters even
+    // though XKB round-trips them. Refuse the entire string before selection;
+    // native EditableText has no such keyboard restriction.
+    u32::from(scalar) <= 0xffff
+        && !scalar.is_control() && !matches!(scalar, '\u{2028}' | '\u{2029}')
+}
+
+fn replacement_prepare_scalars(value: &str) -> Result<String> {
+    let mut unique = std::collections::BTreeSet::new();
+    let mut count = 0;
+    for scalar in value.chars() {
+        count += 1;
+        ensure!(
+            count <= 4096 && replacement_scalar_supported(scalar),
+            "unsupported_replacement_text"
+        );
+        unique.insert(scalar as u32);
+        ensure!(unique.len() <= 128, "unsupported_replacement_text");
+    }
+    Ok(if unique.is_empty() {
+        "-".into()
+    } else {
+        unique
+            .into_iter()
+            .map(|scalar| format!("{scalar:x}"))
+            .collect::<Vec<_>>()
+            .join(",")
+    })
+}
+
+fn replacement_live(client: &Client, deadline: Instant) -> Result<()> {
+    client.cancellation.check()?;
+    ensure!(Instant::now() < deadline, "replacement_deadline");
+    ensure!(
+        !cua_driver_core::session::is_session_ending(&client.owner),
+        "replacement_session_ending"
+    );
+    Ok(())
+}
+
+fn replacement_request(client: &Client, packet: &str, deadline: Instant) -> Result<Value> {
+    replacement_live(client, deadline)?;
+    let deadline = deadline.min(Instant::now() + TIMEOUT);
+    client.send_packet(packet, deadline)?;
+    client.receive(deadline)
+}
+
+fn replacement_target(client: &Client, action: &Action, deadline: Instant) -> Result<Value> {
+    client.check_route(DeliveryRoute::Foreground)?;
+    ensure!(
+        client.foreground_unicode_supported,
+        "foreground_replacement_unavailable"
+    );
+    let target = replacement_request(
+        client,
+        &client.target_packet_routed(action, DeliveryRoute::Foreground),
+        deadline,
+    )?;
+    ensure!(target["ok"] == true, "replacement_target_refused");
+    validate_target_route(&target, DeliveryRoute::Foreground)?;
+    Ok(target)
+}
+
+/// This path deliberately has no stale-geometry retry. Each packet is sent at
+/// most once; only independent observations may be repeated.
+fn replacement_dispatch(
+    client: &mut Client,
+    action: Action,
+    deadline: Instant,
+    uncertain: &mut bool,
+) -> Result<bool> {
+    replacement_live(client, deadline)?;
+    let target = replacement_target(client, &action, deadline)?;
+    let token = hex_field(&target, "target")?;
+    let revision = target["revision"]
+        .as_u64()
+        .context("replacement_revision_unavailable")?;
+    let width = target["width"]
+        .as_f64()
+        .context("replacement_geometry_unavailable")?;
+    let height = target["height"]
+        .as_f64()
+        .context("replacement_geometry_unavailable")?;
+    client.sequence = client
+        .sequence
+        .checked_add(1)
+        .context("replacement_sequence_exhausted")?;
+    let packet = action.packet(client.sequence, &token, revision, width, height)?;
+    replacement_live(client, deadline)?;
+    // An error after this point cannot prove that the compositor did not see
+    // the packet. Never retry or substitute a different route.
+    *uncertain = true;
+    let reply = replacement_request(client, &packet, deadline)?;
+    if reply["ok"] == false {
+        if reply["code"] == "foreground_partial_unknown" {
+            bail!("replacement_delivery_uncertain");
+        }
+        *uncertain = false;
+        return Ok(false);
+    }
+    ensure!(
+        reply["effect"] == "unverifiable" && reply["route"] == "primary_foreground",
+        "replacement_acknowledgement_invalid"
+    );
+    Ok(true)
+}
+
+fn replacement_position_matches(
+    observation: &crate::atspi::native::ReplacementObservation,
+    expected: &str,
+    initial: bool,
+) -> bool {
+    if !observation.focused
+        || observation.value != expected
+        || observation.character_count != expected.chars().count() as i32
+    {
+        return false;
+    }
+    if initial && !expected.is_empty() {
+        observation.selection_count == 1
+            && observation.selection == Some((0, observation.character_count))
+    } else {
+        observation.selection_count == 0
+            && observation.selection.is_none()
+            && observation.caret_offset == observation.character_count
+    }
+}
+
+fn replacement_window_active(client: &Client, deadline: Instant) -> Result<()> {
+    replacement_live(client, deadline)?;
+    ensure!(
+        super::hyprland::target_is_active(client.address, Some(client.pid))?,
+        "replacement_window_focus_lost"
+    );
+    replacement_live(client, deadline)
+}
+
+/// Wait only for an acknowledged key to appear in native readback. Old text
+/// may survive briefly while Chromium processes the event. Any different text,
+/// focus/protection loss, or stale object ends the operation without replay.
+fn replacement_readback(
+    client: &Client,
+    element: &crate::atspi::NativeElement,
+    previous: &str,
+    expected: &str,
+    deadline: Instant,
+) -> Result<()> {
+    settle_replacement_readback(previous, expected, deadline, || {
+        replacement_window_active(client, deadline)?;
+        let observation = crate::atspi::native::check_replacement_field(
+            client.pid,
+            element,
+            true,
+            client.cancellation.0.as_ref(),
+        )?;
+        replacement_window_active(client, deadline)?;
+        Ok(observation)
+    })
+}
+
+fn settle_replacement_readback(
+    previous: &str,
+    expected: &str,
+    deadline: Instant,
+    mut observe: impl FnMut() -> Result<crate::atspi::native::ReplacementObservation>,
+) -> Result<()> {
+    let settle = deadline.min(Instant::now() + REPLACEMENT_READBACK_SETTLE);
+    loop {
+        ensure!(Instant::now() < deadline, "replacement_deadline");
+        let observation = observe()?;
+        ensure!(Instant::now() < deadline, "replacement_deadline");
+        if replacement_position_matches(&observation, expected, false) {
+            return Ok(());
+        }
+        ensure!(
+            observation.focused && observation.value == previous && Instant::now() < settle,
+            "replacement_readback_differs_or_incomplete"
+        );
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+fn replacement_receipt(ok: bool, delivered: usize, uncertain: bool, code: &str) -> Value {
+    json!({
+        "ok":ok, "effect":if ok {"confirmed"} else if uncertain {"unverifiable"} else if delivered > 0 {"partial"} else {"refused"},
+        "code":code,"detail":code,"route":"primary_foreground","replacement_route":"foreground_keyboard",
+        "value_complete":ok,"value_matches":ok,
+        "evidence":if ok {"native_complete_text_readback"} else {"none"},
+        "delivery":{"mode":"foreground","delivered_count":delivered},
+        "delivered_count":delivered,
+    })
+}
+
+/// Explicit foreground replacement, admitted by the common tool registry.
+/// The per-session input mutex is held through every native observation and
+/// compositor packet, so another call on this session cannot interleave keys.
+pub(crate) fn execute_foreground_replacement(
+    owner: Option<String>,
+    pid: u32,
+    address: u64,
+    element: crate::atspi::NativeElement,
+    value: &str,
+    cancellation: ActionCancellation,
+) -> Result<Value> {
+    // Every error propagated by the inner function precedes activation or
+    // editing. Once any side effect can begin, it returns a classified receipt.
+    Ok(
+        execute_foreground_replacement_inner(owner, pid, address, element, value, cancellation)
+            .unwrap_or_else(|_| {
+                replacement_receipt(
+                    false,
+                    0,
+                    false,
+                    "replacement_preflight_or_transport_refused",
+                )
+            }),
+    )
+}
+
+fn execute_foreground_replacement_inner(
+    owner: Option<String>,
+    pid: u32,
+    address: u64,
+    element: crate::atspi::NativeElement,
+    value: &str,
+    cancellation: ActionCancellation,
+) -> Result<Value> {
+    let deadline = Instant::now() + REPLACEMENT_TIMEOUT;
+    let prepared = match replacement_prepare_scalars(value) {
+        Ok(prepared) => prepared,
+        Err(_) => {
+            return Ok(replacement_receipt(
+                false,
+                0,
+                false,
+                "unsupported_replacement_text",
+            ))
+        }
+    };
+    cancellation.check()?;
+    ensure!(
+        enabled() && protocol() == InputProtocol::Production,
+        "foreground replacement transport unavailable"
+    );
+    ensure!(
+        pid > 0 && address > 0 && element.window_id() == address,
+        "exact replacement target required"
+    );
+    let owner = owner.context("authenticated lifecycle required")?;
+    let pooled = session_client(&owner)?;
+    // Bound lock acquisition as well as the transaction. The ordinary helper
+    // intentionally waits for lifecycle cancellation; replacement additionally
+    // has one overall deadline.
+    let mut slot = loop {
+        cancellation.check()?;
+        ensure!(Instant::now() < deadline, "replacement_deadline");
+        match pooled.client.try_lock() {
+            Ok(slot) => break slot,
+            Err(TryLockError::WouldBlock) => std::thread::sleep(CANCELLATION_POLL),
+            Err(TryLockError::Poisoned(_)) => bail!("input connection poisoned"),
+        }
+    };
+    let initial =
+        match crate::atspi::native::replacement_preflight(pid, &element, cancellation.0.as_ref()) {
+            Ok(observation) => observation,
+            Err(error) => {
+                let mut receipt = replacement_receipt(
+                    false,
+                    0,
+                    false,
+                    "native_replacement_preflight_refused",
+                );
+                // The replacement helper deliberately maps D-Bus failures to
+                // static diagnostics and never formats native field content.
+                receipt["detail"] = json!(error.to_string());
+                return Ok(receipt);
+            }
+        };
+    cancellation.check()?;
+    ensure!(Instant::now() < deadline, "replacement_deadline");
+    if slot.as_ref().is_some_and(|client| {
+        client.peer_closed()
+            || client.pid != pid
+            || client.address != address
+            || client.protocol != InputProtocol::Production
+            || client
+                .delivery_route
+                .is_some_and(|route| route != DeliveryRoute::Foreground)
+            || client.lane.and_then(|lane| socket_path(lane).ok()).as_ref() != Some(&client.path)
+    }) {
+        *slot = None;
+    }
+    if slot.is_none() {
+        *slot = Some(claim_available(|lane| {
+            Client::connect(
+                socket_path(lane)?,
+                owner.clone(),
+                pid,
+                address,
+                lane,
+                cancellation.clone(),
+            )
+        })?);
+    }
+    let client = slot
+        .as_mut()
+        .context("missing replacement input connection")?;
+    client.cancellation = cancellation;
+    let mut delivered = 0;
+    let mut uncertain = false;
+    let mut side_effects = false;
+    let operation = (|| -> Result<()> {
+        replacement_live(client, deadline)?;
+        client.attest()?;
+        ensure!(
+            client.foreground_unicode_supported,
+            "foreground_replacement_unavailable"
+        );
+        client.delivery_route = Some(DeliveryRoute::Foreground);
+        // This operation preflights every Unicode scalar without input or
+        // focus changes. A missing plugin/layout capability refuses here.
+        let target = replacement_target(client, &Action::TextBackspace, deadline)?;
+        let token = hex_field(&target, "target")?;
+        let revision = target["revision"]
+            .as_u64()
+            .context("replacement_revision_unavailable")?;
+        let reply = replacement_request(
+            client,
+            &format!("TEXT_PREPARE {token} {revision} {prepared}"),
+            deadline,
+        )?;
+        ensure!(
+            reply["ok"] == true
+                && reply["prepared_count"].as_u64()
+                    == Some(
+                        value
+                            .chars()
+                            .collect::<std::collections::BTreeSet<_>>()
+                            .len() as u64
+                    ),
+            "replacement_text_prepare_refused"
+        );
+        ensure!(
+            replacement_dispatch(client, Action::Activate, deadline, &mut uncertain)?,
+            "replacement_activation_refused"
+        );
+        side_effects = true;
+        replacement_window_active(client, deadline)?;
+        uncertain = true;
+        let focused = crate::atspi::native::focus_replacement_field(
+            pid,
+            &element,
+            client.cancellation.0.as_ref(),
+        )?;
+        ensure!(
+            focused.value == initial.value,
+            "replacement_value_changed_before_selection"
+        );
+        replacement_window_active(client, deadline)?;
+        crate::atspi::native::select_replacement_text(
+            pid,
+            &element,
+            &initial.value,
+            client.cancellation.0.as_ref(),
+        )?;
+        let mut expected = String::new();
+        let actions: Vec<Action> = if value.is_empty() {
+            if initial.value.is_empty() {
+                Vec::new()
+            } else {
+                vec![Action::TextBackspace]
+            }
+        } else {
+            value
+                .chars()
+                .map(|scalar| Action::Unicode { scalar })
+                .collect()
+        };
+        for (index, action) in actions.into_iter().enumerate() {
+            let previous = if index == 0 {
+                initial.value.as_str()
+            } else {
+                expected.as_str()
+            };
+            replacement_window_active(client, deadline)?;
+            let observed = crate::atspi::native::check_replacement_field(
+                pid,
+                &element,
+                true,
+                client.cancellation.0.as_ref(),
+            )?;
+            ensure!(
+                replacement_position_matches(&observed, previous, index == 0),
+                "replacement_selection_or_caret_changed"
+            );
+            replacement_window_active(client, deadline)?;
+            let mut next = expected.clone();
+            if let Action::Unicode { scalar } = &action {
+                next.push(*scalar);
+            }
+            ensure!(
+                replacement_dispatch(client, action, deadline, &mut uncertain)?,
+                "replacement_input_refused"
+            );
+            // Count acknowledged editing packets, not inferred characters.
+            // A later readback failure still retains this delivery evidence.
+            delivered += 1;
+            replacement_readback(client, &element, previous, &next, deadline)?;
+            uncertain = false;
+            expected = next;
+        }
+        replacement_readback(client, &element, value, value, deadline)?;
+        Ok(())
+    })();
+    // A fresh plan is mandatory for every invocation. Closing the connection
+    // revokes it on all exits, including cancellation and partial delivery.
+    *slot = None;
+    let mut receipt = replacement_receipt(
+        operation.is_ok(),
+        delivered,
+        uncertain,
+        if operation.is_ok() {
+            "replacement_verified"
+        } else if uncertain {
+            "replacement_delivery_or_readback_uncertain"
+        } else {
+            "replacement_refused_or_interrupted"
+        },
+    );
+    if operation.is_err() && side_effects && delivered == 0 {
+        receipt["effect"] = json!("unverifiable");
+    }
+    Ok(receipt)
+}
