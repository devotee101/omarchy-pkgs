+            assert_eq!(read_packet(&peer), "FOREGROUND_TARGET 1 1 2");
+            peer.send(json!({"ok":true,"route":"primary_foreground","target":TOKEN,"revision":7,"width":100,"height":100}).to_string().as_bytes()).unwrap();
+            assert_eq!(read_packet(&peer), format!("UNICODE 1 {TOKEN} 7 6771"));
+            peer.send(br#"{"ok":false,"code":"stale_geometry","detail":"stale_geometry"}"#)
+                .unwrap();
+            peer
+        });
+        let mut uncertain = false;
+        assert!(!replacement_dispatch(
+            &mut client,
+            Action::Unicode { scalar: '東' },
+            Instant::now() + TIMEOUT,
+            &mut uncertain
+        )
+        .unwrap());
+        assert!(!uncertain);
+        let peer = server.join().unwrap();
+        peer.set_nonblocking(true).unwrap();
+        let mut byte = 0u8;
+        assert_eq!(
+            unsafe {
+                libc::recv(
+                    peer.as_raw_fd(),
+                    (&mut byte as *mut u8).cast(),
+                    1,
+                    libc::MSG_DONTWAIT,
+                )
+            },
+            -1
+        );
