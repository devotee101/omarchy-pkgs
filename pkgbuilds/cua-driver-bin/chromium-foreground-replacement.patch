+/// Complete ordinary-field readback from one retained snapshot object. Deliberately
+/// not Debug/Serialize: callers may compare the value, but must not log it.
+pub struct ReplacementObservation {
+    pub value: String,
+    pub character_count: i32,
+    pub focused: bool,
+    pub caret_offset: i32,
+    pub selection_count: i32,
+    pub selection: Option<(i32, i32)>,
+}
+
+fn replacement_offsets_valid(
+    count: i32,
+    caret: i32,
+    selections: i32,
+    selection: Option<(i32, i32)>,
+    focused: bool,
+    require_focus: bool,
+) -> bool {
+    // Chromium reports -1 before the field has focus. That is unknown
+    // position, not permission to type. Only read-only preflight accepts it;
+    // focused selection and every input guard require a real native offset.
+    let caret_valid = (0..=count).contains(&caret)
+        || (caret == -1 && !focused && !require_focus);
+    count >= 0 && caret_valid && (0..=1).contains(&selections)
+        && !selection.is_some_and(|(start, end)| start < 0 || end < start || end > count)
+}
+
+fn replacement_cancelled(cancelled: &AtomicBool) -> Result<()> {
+    if cancelled.load(Ordering::Acquire) {
+        Err(anyhow!("replacement_cancelled"))
+    } else {
+        Ok(())
+    }
+}
+
+fn replacement_field_guard(
+    role: &str,
+    state: &StateSet,
+    attrs: &NativeAttributes,
+    has_text: bool,
+    has_editable: bool,
+    has_component: bool,
+    require_focus: bool,
+) -> Result<()> {
+    if text_read_guard(Some(role), Some(state), Some(attrs)).is_some() {
+        return Err(anyhow!(
+            "unsupported: field protection/readability is not established"
+        ));
+    }
+    if !state.contains(State::Editable)
+        || state.contains(State::ReadOnly)
+        || !is_enabled_state(state)
+    {
+        return Err(anyhow!("unsupported: field is not enabled and editable"));
+    }
+    if !matches!(
+        role.to_ascii_lowercase().as_str(),
+        "entry" | "text" | "combo box" | "combobox"
+    ) {
+        return Err(anyhow!(
+            "unsupported: foreground replacement requires an ordinary text field"
+        ));
+    }
+    if !has_text || has_editable || !has_component {
+        return Err(anyhow!(
+            "unsupported: foreground replacement requires Text and Component without EditableText"
+        ));
+    }
+    if require_focus && !state.contains(State::Focused) {
+        return Err(anyhow!(
+            "replacement_focus_lost: retained field is not focused"
+        ));
+    }
+    Ok(())
+}
+
+async fn replacement_observe(
+    pid: u32,
+    element: &NativeElement,
+    require_focus: bool,
+    cancelled: &AtomicBool,
+) -> Result<ReplacementObservation> {
+    replacement_cancelled(cancelled)?;
+    if !is_chromium_executable(pid) {
+        return Err(anyhow!(
+            "unsupported: foreground text replacement is limited to Chromium"
+        ));
+    }
+    let target = validated_target(pid, element)
+        .await
+        .map_err(|_| anyhow!("stale_native_element: replacement target binding lost"))?;
+    let (state, role, attrs, interfaces) = tokio::join!(
+        call(target.acc.get_state()),
+        call(target.acc.get_role_name()),
+        call(target.acc.get_attributes()),
+        call(target.acc.get_interfaces()),
+    );
+    let state = state
+        .and_then(Result::ok)
+        .context("unsupported: replacement state unavailable")?;
+    let role = role
+        .and_then(Result::ok)
+        .context("unsupported: replacement role unavailable")?;
+    let attrs = attrs
+        .and_then(Result::ok)
+        .context("unsupported: replacement protection unavailable")?;
+    let interfaces = interfaces
+        .and_then(Result::ok)
+        .context("unsupported: replacement interfaces unavailable")?;
+    let input_type = ["text-input-type", "input-type"]
+        .iter()
+        .find_map(|key| attrs.get(*key).filter(|value| !value.is_empty()));
+    if role != target.role || input_type != target.text.input_type.as_ref() {
+        return Err(anyhow!(
+            "replacement_field_changed: native field type changed"
+        ));
+    }
+    replacement_field_guard(
+        &role,
+        &state,
+        &attrs,
+        interfaces.contains(Interface::Text),
+        interfaces.contains(Interface::EditableText),
+        interfaces.contains(Interface::Component),
+        require_focus,
+    )?;
+    replacement_cancelled(cancelled)?;
+    let (value, status) = read_field_value(&target.acc).await;
+    if status != "complete" {
+        return Err(anyhow!(
+            "unsupported: complete replacement readback unavailable"
+        ));
+    }
+    let value = value.context("unsupported: replacement readback missing")?;
+    let proxies = call(target.acc.proxies())
+        .await
+        .and_then(Result::ok)
+        .context("unsupported: replacement interface lookup failed")?;
+    let text = call(proxies.text())
+        .await
+        .and_then(Result::ok)
+        .context("unsupported: replacement Text unavailable")?;
+    let caret_offset = call(text.caret_offset())
+        .await
+        .and_then(Result::ok)
+        .context("unsupported: replacement caret readback unavailable")?;
+    let selection_count = call(text.get_n_selections())
+        .await
+        .and_then(Result::ok)
+        .context("unsupported: replacement selection readback unavailable")?;
+    let selection = if selection_count == 1 {
+        Some(
+            call(text.get_selection(0))
+                .await
+                .and_then(Result::ok)
+                .context("unsupported: replacement selection bounds unavailable")?,
+        )
+    } else {
+        None
+    };
+    let character_count = value.chars().count() as i32;
+    if !replacement_offsets_valid(character_count, caret_offset, selection_count, selection,
+        state.contains(State::Focused), require_focus) {
+        return Err(anyhow!("unsupported: ambiguous replacement text offsets"));
+    }
+
+    // Re-read all mutation-relevant metadata after the text calls. A focus or
+    // protection change while reading must not authorize a subsequent key.
+    let target = validated_target(pid, element)
+        .await
+        .map_err(|_| anyhow!("stale_native_element: replacement target binding lost"))?;
+    let (state, role, attrs, interfaces) = tokio::join!(
+        call(target.acc.get_state()),
+        call(target.acc.get_role_name()),
+        call(target.acc.get_attributes()),
+        call(target.acc.get_interfaces()),
+    );
+    let state = state
+        .and_then(Result::ok)
+        .context("unsupported: replacement state unavailable")?;
+    let role = role
+        .and_then(Result::ok)
+        .context("unsupported: replacement role unavailable")?;
+    let attrs = attrs
+        .and_then(Result::ok)
+        .context("unsupported: replacement protection unavailable")?;
+    let interfaces = interfaces
+        .and_then(Result::ok)
+        .context("unsupported: replacement interfaces unavailable")?;
+    let input_type = ["text-input-type", "input-type"]
+        .iter()
+        .find_map(|key| attrs.get(*key).filter(|value| !value.is_empty()));
+    if role != target.role || input_type != target.text.input_type.as_ref() {
+        return Err(anyhow!(
+            "replacement_field_changed: native field type changed"
+        ));
+    }
+    replacement_field_guard(
+        &role,
+        &state,
+        &attrs,
+        interfaces.contains(Interface::Text),
+        interfaces.contains(Interface::EditableText),
+        interfaces.contains(Interface::Component),
+        require_focus,
+    )?;
+    replacement_cancelled(cancelled)?;
+    Ok(ReplacementObservation {
+        character_count,
+        caret_offset,
+        selection_count,
+        selection,
+        value,
+        focused: state.contains(State::Focused),
+    })
+}
+
+/// Preflight is read-only. Root tooling must separately prove the foreground
+/// compositor window and preflight every input character before changing focus.
+pub fn replacement_preflight(
+    pid: u32,
+    element: &NativeElement,
+    cancelled: &AtomicBool,
+) -> Result<ReplacementObservation> {
+    check_replacement_field(pid, element, false, cancelled)
+}
+
+/// Call before and after each delivered scalar. The compositor window proof is
+/// additional to this native retained-object/focus/protection proof.
+pub fn check_replacement_field(
+    pid: u32,
+    element: &NativeElement,
+    require_focus: bool,
+    cancelled: &AtomicBool,
+) -> Result<ReplacementObservation> {
+    bounded(
+        replacement_observe(pid, &element, require_focus, &cancelled),
+        || Err(anyhow!("replacement_readback_timeout")),
+    )
+}
+
+/// Focus exactly the retained object and independently verify Focused state.
+/// Does not activate a window; the explicit foreground route owns that step.
+pub fn focus_replacement_field(
+    pid: u32,
+    element: &NativeElement,
+    cancelled: &AtomicBool,
+) -> Result<ReplacementObservation> {
+    bounded(
+        async {
+            let before = replacement_observe(pid, &element, false, &cancelled).await?;
+            if before.focused {
+                return Ok(before);
+            }
+            let target = validated_target(pid, &element)
+                .await
+                .map_err(|_| anyhow!("stale_native_element: replacement target binding lost"))?;
+            let proxies = call(target.acc.proxies())
+                .await
+                .and_then(Result::ok)
+                .context("unsupported: replacement interface lookup failed")?;
+            let component = call(proxies.component())
+                .await
+                .and_then(Result::ok)
+                .context("unsupported: replacement Component unavailable")?;
+            replacement_cancelled(&cancelled)?;
+            let accepted = call(component.grab_focus())
+                .await
+                .and_then(Result::ok)
+                .context("outcome_uncertain: replacement focus acknowledgement unavailable")?;
+            if !accepted {
+                return Err(anyhow!("unsupported: replacement field refused focus"));
+            }
+            let after = replacement_observe(pid, &element, true, &cancelled).await?;
+            if after.value != before.value {
+                return Err(anyhow!(
+                    "replacement_value_changed: field changed while focusing"
+                ));
+            }
+            Ok(after)
+        },
+        || Err(anyhow!("outcome_uncertain: replacement focus timed out")),
+    )
+}
+
+fn full_selection_matches(
+    count: i32,
+    selections: i32,
+    range: Option<(i32, i32)>,
+    caret: Option<i32>,
+) -> bool {
+    if count == 0 {
+        selections == 0 && caret == Some(0)
+    } else {
+        count > 0 && selections == 1 && range == Some((0, count))
+    }
+}
+
+/// Establish a full native text selection before the foreground route sends a
+/// replacement scalar or Delete. Never uses an unbound global Select All key.
+/// An empty value is verified at caret zero without fabricating a selection.
+pub fn select_replacement_text(
+    pid: u32,
+    element: &NativeElement,
+    expected_value: &str,
+    cancelled: &AtomicBool,
+) -> Result<ReplacementObservation> {
+    bounded(
+        async {
+            let before = replacement_observe(pid, &element, true, &cancelled).await?;
+            if before.value != expected_value {
+                return Err(anyhow!(
+                    "replacement_value_changed: field changed before selection"
+                ));
+            }
+            let target = validated_target(pid, &element)
+                .await
+                .map_err(|_| anyhow!("stale_native_element: replacement target binding lost"))?;
