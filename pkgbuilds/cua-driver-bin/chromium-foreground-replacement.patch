+#[derive(Default)]
+struct ReplacementCapabilityCache {
+    path: Option<PathBuf>,
+    checked: Option<Instant>,
+    inflight: bool,
+    value: Option<bool>,
+}
+static REPLACEMENT_CAPABILITY: OnceLock<Mutex<ReplacementCapabilityCache>> = OnceLock::new();
+
+fn probe_replacement_capability(path: PathBuf) -> Option<bool> {
+    let deadline = Instant::now() + Duration::from_millis(100);
+    let socket = socket2::Socket::new(
+        socket2::Domain::UNIX,
+        socket2::Type::from(libc::SOCK_SEQPACKET),
+        None,
+    )
+    .ok()?;
+    socket
+        .connect_timeout(
+            &socket2::SockAddr::unix(&path).ok()?,
+            Duration::from_millis(100),
+        )
+        .ok()?;
+    socket.set_nonblocking(true).ok()?;
+    let client = Client {
+        socket,
+        cancellation: ActionCancellation::default(),
+        protocol: InputProtocol::Production,
+        foreground_supported: false,
+        foreground_unicode_supported: false,
+        delivery_route: None,
+        lane: None,
+        owner: "replacement-capability-readonly".into(),
+        path,
+        pid: 0,
+        address: 0,
+        epoch: String::new(),
+        challenge: String::new(),
+        sequence: 0,
+    };
+    client.attest().ok()?;
+    replacement_hello_capability(&client, deadline)
+}
+
+fn replacement_hello_capability(client: &Client, deadline: Instant) -> Option<bool> {
+    // HELLO is discovery only: do not CLAIM a lane, TARGET a window or dispatch.
+    client.send_packet("HELLO", deadline).ok()?;
+    let hello = client.receive(deadline).ok()?;
+    if hello["ok"] != true || hello["protocol"] != 3 {
+        return None;
+    }
+    Some(replacement_hello_supported(&hello))
+}
+
+fn replacement_hello_supported(hello: &Value) -> bool {
+    hello["foreground_target"] == true && hello["foreground_unicode_scalar"] == true
+        && hello["foreground_unicode_max"].as_u64().is_some_and(|max| max >= 0xffff)
+}
+
+/// Best-effort read-only transport evidence. The first call waits at most
+/// 100ms; subsequent captures share a one-second cache and never reserve lanes.
+pub(crate) fn foreground_replacement_capability() -> Option<bool> {
+    if protocol() != InputProtocol::Production || !enabled() {
+        return Some(false);
+    }
+    let path = socket_path(0).ok()?;
+    let cache = REPLACEMENT_CAPABILITY.get_or_init(Default::default);
+    let mut state = cache.lock().ok()?;
+    if state.path.as_ref() == Some(&path) {
+        if state.inflight
+            || state
+                .checked
+                .is_some_and(|at| at.elapsed() < Duration::from_secs(1))
+        {
+            return state.value;
+        }
+    } else if state.inflight {
+        return None;
+    }
+    state.path = Some(path.clone());
+    state.inflight = true;
+    state.value = None;
+    drop(state);
+    let (sender, receiver) = std::sync::mpsc::sync_channel(1);
+    std::thread::spawn(move || {
+        let value = probe_replacement_capability(path);
+        if let Ok(mut state) = REPLACEMENT_CAPABILITY.get().unwrap().lock() {
+            state.value = value;
+            state.checked = Some(Instant::now());
+            state.inflight = false;
+        }
+        let _ = sender.send(value);
+    });
+    receiver
+        .recv_timeout(Duration::from_millis(100))
+        .ok()
+        .flatten()
+}
