+    #[test]
+    fn replacement_activation_loss_partial_ack_and_postactivation_failure_are_unknown() {
+        for reply in [
+            None,
+            Some(
+                json!({"ok":false,"code":"foreground_partial_unknown","detail":"foreground_partial_unknown"}),
+            ),
+            Some(json!({"ok":true,"effect":"unverifiable","route":"primary_foreground"})),
+        ] {
+            let (mut client, peer) = production_test_client();
+            client.foreground_unicode_supported = true;
+            let acknowledgement_expected = reply.as_ref().is_some_and(|reply| reply["ok"] == true);
+            let server = std::thread::spawn(move || {
+                assert_eq!(read_packet(&peer), "FOREGROUND_TARGET 1 1 16");
+                peer.send(json!({"ok":true,"route":"primary_foreground","target":TOKEN,"revision":7,"width":100,"height":100}).to_string().as_bytes()).unwrap();
+                assert_eq!(read_packet(&peer), format!("ACTIVATE 1 {TOKEN} 7"));
+                if let Some(reply) = reply {
+                    peer.send(reply.to_string().as_bytes()).unwrap();
+                }
+            });
+            let mut uncertain = false;
+            let dispatched = replacement_dispatch(
+                &mut client,
+                Action::Activate,
+                Instant::now() + TIMEOUT,
+                &mut uncertain,
+            );
+            assert_eq!(dispatched.is_ok(), acknowledgement_expected);
+            assert!(uncertain);
+            // Simulate failure of the independent active-window/native-focus
+            // read that follows the successful acknowledgement.
+            assert_eq!(
+                replacement_receipt(false, 0, uncertain, "postactivation_readback_failed")
+                    ["effect"],
+                "unverifiable"
+            );
+            server.join().unwrap();
+        }
+    }
