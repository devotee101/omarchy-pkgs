+/// Native-only is deliberately the default. Permission normalization may
+/// downgrade delivery_mode; it must never leave a foreground route executable.
+fn foreground_replacement_requested(args: &Value) -> Result<bool, &'static str> {
+    match (args.get("replacement_route"), args.get("delivery_mode")) {
+        (None, None) => Ok(false),
+        (None, Some(Value::String(mode))) if mode == "background" => Ok(false),
+        (Some(Value::String(route)), mode) if route == "native" => match mode {
+            None => Ok(false),
+            Some(Value::String(mode)) if mode == "background" => Ok(false),
+            _ => Err("Native replacement requires background delivery; foreground replacement must be selected explicitly."),
+        },
+        (Some(Value::String(route)), Some(Value::String(mode)))
+            if route == "foreground_keyboard" && mode == "foreground" => Ok(true),
+        _ => Err("Foreground replacement requires replacement_route=foreground_keyboard and delivery_mode=foreground; no automatic fallback is available."),
+    }
+}
+
+fn foreground_replacement_result(result: anyhow::Result<Value>) -> ToolResult {
+    use cua_driver_core::action_record::{
+        ActionEffect, ActionEvidence, ActionExecutionRecord, ActionTransport, ActualDelivery,
+        EvidenceKind, RequestedDelivery,
+    };
+    let reply = result.unwrap_or_else(|_| json!({"ok":false,"effect":"unverifiable",
+        "code":"replacement_outcome_uncertain","detail":"Replacement worker did not establish an outcome; refresh state before another action."}));
+    let confirmed = reply["ok"] == true && reply["effect"] == "confirmed"
+        && reply["evidence"] == "native_complete_text_readback"
+        && reply["value_complete"] == true && reply["value_matches"] == true;
+    let count = reply["delivered_count"].as_u64().and_then(|v| u32::try_from(v).ok()).unwrap_or(0);
+    let effect = if confirmed { ActionEffect::Confirmed }
+        else if reply["effect"] == "refused" && count == 0 { ActionEffect::Refused }
+        else if count > 0 { ActionEffect::Partial }
+        else { ActionEffect::Unverifiable };
+    let detail = reply["detail"].as_str().unwrap_or(
+        "Foreground replacement requires independent native readback; refresh state before another action.").to_owned();
+    let mut record = ActionExecutionRecord::builder(effect,
+        ActionTransport::LinuxHyprlandForegroundInput, RequestedDelivery::Foreground)
+        .detail(detail.clone());
+    if effect != ActionEffect::Refused {
+        record = record.actual_delivery(if confirmed {ActualDelivery::Foreground} else {ActualDelivery::Unknown})
+            .delivered_count(count);
+    }
+    if confirmed {
+        record = record.evidence(ActionEvidence {kind:EvidenceKind::ValueReadback,
+            detail:"Complete native text from the same retained window-bound field exactly matched the replacement.".into()});
+    }
+    let record = record.build().expect("foreground replacement record");
+    let mut public = serde_json::to_value(record.public_result().unwrap()).unwrap();
+    if !confirmed {
+        public["code"] = json!(reply.get("code").and_then(Value::as_str)
+            .unwrap_or("replacement_not_confirmed"));
+    }
+    (if confirmed {ToolResult::text(detail)} else {ToolResult::error(detail)})
+        .with_structured(public).with_action_record(record)
+}
