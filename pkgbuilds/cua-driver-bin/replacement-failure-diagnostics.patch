+// Only fixed diagnostic labels may leave this boundary; never expose a
+// native field value or an arbitrary transport error in an action receipt.
+fn replacement_failure_reason(error: &anyhow::Error) -> &'static str {
+    match error.to_string().as_str() {
+        "replacement_deadline" => "deadline",
+        "replacement_window_focus_lost" => "window_focus_lost",
+        "replacement_selection_or_caret_changed" => "selection_or_caret_changed",
+        "replacement_readback_differs_or_incomplete" => "readback_differs_or_incomplete",
+        "replacement_target_refused" => "target_refused",
+        "replacement_input_refused" => "input_refused",
+        "replacement_delivery_uncertain" => "delivery_uncertain",
+        "replacement_cancelled" => "cancelled",
+        "replacement_focus_lost: retained field is not focused" => "field_focus_lost",
+        "unsupported: complete replacement readback unavailable" => "native_readback_incomplete",
+        "unsupported: ambiguous replacement text offsets" => "native_offsets_ambiguous",
+        "replacement_readback_timeout" => "native_readback_timeout",
+        _ => "unclassified_failure",
+    }
+}
