+fn selection_action_index(role: &str, selectable: bool, actions: &[String]) -> Option<usize> {
+    if !selectable
+        || !matches!(
+            role.trim().to_ascii_lowercase().as_str(),
+            "list item" | "tree item" | "table cell" | "page tab" | "menu item"
+        )
+    {
+        return None;
+    }
