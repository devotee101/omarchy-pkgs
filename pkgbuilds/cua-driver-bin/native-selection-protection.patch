+        call(acc.get_state()),
+        call(acc.get_attributes())
+    );
+    let role = role.and_then(Result::ok);
+    let state = state.and_then(Result::ok);
+    let attrs = attrs.and_then(Result::ok);
+    text_read_guard(role.as_deref(), state.as_ref(), attrs.as_ref())
+}
