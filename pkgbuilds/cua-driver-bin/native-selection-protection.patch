+fn native_activation_result(
+    result: anyhow::Result<crate::atspi::NativeActivationOutcome>,
+    foreground: bool,
+) -> ToolResult {
+    use cua_driver_core::action_record::{
+        ActionEffect, ActionEvidence, ActionExecutionRecord, ActionTransport, ActualDelivery,
+        EvidenceKind, RequestedDelivery,
+    };
+    let (effect, detail, delivery, failed) = match result {
+        Ok(outcome) => match outcome.selection {
+            Some(selection) if selection.selected == Some(true) => (ActionEffect::Confirmed,
+                "atspi.Action.select: the exact retained result is Selected on fresh native readback.".to_owned(),
+                Some(ActualDelivery::Background), false),
+            Some(selection) => (ActionEffect::Unverifiable,
+                format!("atspi.Action.select was acknowledged, but selection is {}; refresh state before another action.", selection.status),
+                Some(ActualDelivery::Background), true),
+            None => (if outcome.suspected_noop { ActionEffect::SuspectedNoop } else { ActionEffect::Unverifiable },
+                format!("Native {} was acknowledged; its final effect is not verified.", outcome.action),
+                Some(ActualDelivery::Background), false),
+        },
+        Err(error) => {
+            let uncertain = error.to_string().starts_with("outcome_uncertain:");
+            (if uncertain {ActionEffect::Unverifiable} else {ActionEffect::Refused}, error.to_string(),
+                uncertain.then_some(ActualDelivery::Unknown), true)
+        }
+    };
+    let mut record = ActionExecutionRecord::builder(
+        effect,
+        ActionTransport::LinuxAtSpiAction,
+        if foreground {
+            RequestedDelivery::Foreground
+        } else {
+            RequestedDelivery::Background
+        },
+    )
+    .detail(detail.clone());
+    if let Some(delivery) = delivery {
+        record = record.actual_delivery(delivery);
+    }
+    if effect == ActionEffect::Confirmed {
+        record = record.evidence(ActionEvidence { kind: EvidenceKind::AccessibilityReadback,
+            detail: "Selected state was read independently from the same live, window-bound native result.".into() });
+    }
+    let record = record.build().expect("native activation action record");
+    let structured = serde_json::to_value(
+        record
+            .public_result()
+            .expect("native activation projection"),
+    )
+    .expect("native activation JSON");
+    let result = if failed {
+        ToolResult::error(detail)
+    } else {
+        ToolResult::text(detail)
+    };
+    result
+        .with_structured(structured)
+        .with_action_record(record)
+}
