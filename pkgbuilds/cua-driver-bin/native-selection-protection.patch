+    /// Present only for the role/state-gated native Action `select` operation.
+    pub selection: Option<NativeSelectionOutcome>,
+}
+
+fn selection_readback(state: Option<&StateSet>) -> NativeSelectionOutcome {
+    match state {
+        Some(state) if state.contains(State::Defunct) || state.contains(State::Stale) => {
+            NativeSelectionOutcome {
+                selected: None,
+                status: "target_lost",
+            }
+        }
+        Some(state) if state.contains(State::Selectable) => {
+            let selected = state.contains(State::Selected);
+            NativeSelectionOutcome {
+                selected: Some(selected),
+                status: if selected { "selected" } else { "not_selected" },
+            }
+        }
+        _ => NativeSelectionOutcome {
+            selected: None,
+            status: "readback_unavailable",
+        },
+    }
+}
