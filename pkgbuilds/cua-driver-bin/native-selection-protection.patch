+fn selected_observation(role: &str, state: Option<&StateSet>) -> Option<bool> {
+    let state = state?;
+    if role.contains("check") {
+        Some(state.contains(State::Checked))
+    } else if role.contains("radio") {
+        Some(state.contains(State::Selected) || state.contains(State::Checked))
+    } else if state.contains(State::Selectable)
+        || role.contains("list item")
+        || role.contains("menu item")
+        || matches!(role, "tab" | "page tab" | "tab item")
+    {
+        Some(state.contains(State::Selected))
+    } else {
+        None
+    }
+}
+
+fn apply_read_guard_status(text: &mut NativeTextObservation, status: &str) {
+    if status == "protected" {
+        text.protected = Some(true);
+        text.protection_source = "atspi.Role/Attributes".into();
+    } else if status == "protection_unknown" {
+        text.protected = None;
+        text.protection_source = "unavailable".into();
+    }
+    text.value_status = status.into();
+    text.value_complete = status == "complete";
+}
+
+async fn fresh_read_guard(acc: &AccessibleProxy<'_>) -> Option<&'static str> {
