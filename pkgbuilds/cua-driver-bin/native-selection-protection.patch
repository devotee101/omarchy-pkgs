+fn chromium_executable_name(path: &std::path::Path, link_count: u64) -> bool {
+    let Some(name) = path.file_name().and_then(|name| name.to_str()) else {
+        return false;
+    };
+    // Only /proc metadata proving an unlinked inode permits interpretation of
+    // the kernel's suffix. A linked executable literally named `chrome
+    // (deleted)` is not an allowlisted Chromium basename.
+    let name = if link_count == 0 {
+        name.strip_suffix(" (deleted)").unwrap_or(name)
+    } else {
+        name
+    };
+    matches!(name, "chromium" | "chromium-browser" | "chrome")
+}
+
+fn is_chromium_executable(pid: u32) -> bool {
+    use std::os::unix::fs::MetadataExt;
+    let executable = format!("/proc/{pid}/exe");
+    let Ok(path) = std::fs::read_link(&executable) else {
+        return false;
+    };
+    let Ok(metadata) = std::fs::metadata(&executable) else {
+        return false;
+    };
+    // Fail closed if exec/replacement changed the reported path while reading
+    // metadata. Existing snapshot process and peer checks remain in force.
+    std::fs::read_link(&executable).ok().as_ref() == Some(&path)
+        && chromium_executable_name(&path, metadata.nlink())
+}
