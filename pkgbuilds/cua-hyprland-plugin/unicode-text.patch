+#pragma once
+
+#include <xkbcommon/xkbcommon.h>
+#include <charconv>
+#include <cstdint>
+#include <cstdlib>
+#include <exception>
+#include <format>
+#include <map>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+
+namespace cua::hyprland {
+constexpr std::uint32_t kUnicodeEvdevCode = 30;
+constexpr std::size_t kMaxUnicodeScalars = 128;
+// Chromium truncates supplementary-plane key events to 16 bits on this route.
+// Reject them before any field selection or editing.
+constexpr std::uint32_t kMaxForegroundUnicodeScalar = 0xffff;
+
+inline bool printable_unicode_scalar(std::uint32_t scalar) {
+    return scalar >= 0x20 && scalar <= kMaxForegroundUnicodeScalar && !(scalar >= 0x7f && scalar <= 0x9f) &&
+        !(scalar >= 0xd800 && scalar <= 0xdfff) && scalar != 0x2028 && scalar != 0x2029;
+}
+
+inline std::string unicode_scalar_keymap(std::uint32_t scalar) {
+    if (!printable_unicode_scalar(scalar)) throw std::runtime_error("unsupported Unicode scalar");
+    const auto source = std::format(R"(xkb_keymap {{
+ xkb_keycodes {{ minimum=8; maximum=255; <CUAT>=38; }};
+ xkb_types {{ type "ONE_LEVEL" {{ modifiers=None; map[None]=Level1; }}; }};
+ xkb_compatibility {{ }};
+ xkb_symbols {{ key <CUAT> {{ type="ONE_LEVEL", [ U{:04X} ] }}; }};
+}};)", scalar);
+    const auto context = std::unique_ptr<xkb_context, decltype(&xkb_context_unref)>(
+        xkb_context_new(XKB_CONTEXT_NO_ENVIRONMENT_NAMES), xkb_context_unref);
+    if (!context) throw std::runtime_error("Unicode XKB context unavailable");
+    const auto map = std::unique_ptr<xkb_keymap, decltype(&xkb_keymap_unref)>(
+        xkb_keymap_new_from_string(context.get(), source.c_str(), XKB_KEYMAP_FORMAT_TEXT_V1, XKB_KEYMAP_COMPILE_NO_FLAGS), xkb_keymap_unref);
+    const auto state = std::unique_ptr<xkb_state, decltype(&xkb_state_unref)>(
+        map ? xkb_state_new(map.get()) : nullptr, xkb_state_unref);
+    if (!state || xkb_state_key_get_utf32(state.get(), kUnicodeEvdevCode + 8) != scalar)
+        throw std::runtime_error("Unicode scalar failed XKB preflight");
+    const auto serialized = std::unique_ptr<char, decltype(&std::free)>(
+        xkb_keymap_get_as_string(map.get(), XKB_KEYMAP_FORMAT_TEXT_V1), std::free);
+    if (!serialized) throw std::runtime_error("Unicode XKB serialization unavailable");
+    return serialized.get();
+}
+
+inline std::map<std::uint32_t, std::string> prepare_unicode_maps(std::string_view input) {
+    std::map<std::uint32_t, std::string> result;
+    if (input == "-") return result;
+    while (!input.empty()) {
+        const auto comma = input.find(',');
+        const auto part = input.substr(0, comma);
+        std::uint32_t scalar = 0;
+        const auto [end, error] = std::from_chars(part.data(), part.data() + part.size(), scalar, 16);
+        if (part.empty() || error != std::errc{} || end != part.data() + part.size())
+            throw std::runtime_error("invalid Unicode scalar list");
+        if (!result.contains(scalar)) {
+            if (result.size() >= kMaxUnicodeScalars) throw std::runtime_error("too many Unicode scalars");
+            result.emplace(scalar, unicode_scalar_keymap(scalar));
+        }
+        if (comma == std::string_view::npos) return result;
+        input.remove_prefix(comma + 1);
+        if (input.empty()) throw std::runtime_error("invalid Unicode scalar list");
+    }
+    throw std::runtime_error("empty Unicode scalar list requires dash");
+}
+
+// Restore every possibly modified resource, including when install or dispatch
+// fails. The callbacks own exact-resource and focus guards; no global keymap is
+// changed. Restoration failure is always uncertain and cannot become a retry.
+template <typename Install, typename Dispatch, typename Restore>
+void with_unicode_keymaps(std::size_t resource_count, Install install, Dispatch dispatch, Restore restore) {
+    std::size_t touched = 0;
+    std::exception_ptr failure;
+    try {
+        for (std::size_t i = 0; i < resource_count; ++i) {
+            touched = i + 1;
+            install(i);
+        }
+        dispatch();
+    } catch (...) { failure = std::current_exception(); }
+    bool restore_failed = false;
+    for (std::size_t i = 0; i < touched; ++i) {
+        try { restore(i); } catch (...) { restore_failed = true; }
+    }
+    if (restore_failed) throw std::runtime_error("Unicode keymap restoration uncertain");
+    if (failure) std::rethrow_exception(failure);
+}
+} // namespace cua::hyprland
